# 1. 6551 Twitter WebSocket token
TWITTER_TOKEN=在这里填入

# 2. Together API key
TOGETHER_API_KEY=在这里填入

# 3. 钱包私钥，只放小额热钱包
PRIVATE_KEY=在这里填入

# 4. BSC RPC
BSC_RPC_URL=https://bsc-dataseed.binance.org

# 5. Telegram bot token 和 chat id
TG_BOT_TOKEN=在这里填入
TG_CHAT_ID=在这里填入
# 如果 Mac 直连 Telegram 超时，填本地代理，例如 http://127.0.0.1:7897
TG_PROXY=

# 6. 监控账号，不带 @，逗号分隔，大小写按 6551 返回为准
WATCH_ACCOUNTS=cz_binance,heyibinance,Binance,Binancezh

# 7. 创建时 dev 买入金额，单位 BNB。fourmeme --pre-sale 使用 BNB/ether，不是 wei。
BUY_AMOUNT_BNB=0.001
# 防手滑上限，BUY_AMOUNT_BNB 不能超过它
MAX_BUY_BNB=0.005

# 8. gas 和滑点
GAS_PRICE_GWEI=3
SLIPPAGE_PERCENT=50

# 9. 总开关。false = 只监听不创建
ENABLED=true
# 测试开关。true = 不真发交易，只打印命令；真跑用 false 或直接删除这一行
DRY_RUN=true

# 10. 速度：fast / normal
SPEED_MODE=fast
IMAGE_TIMEOUT_MS=4500

# 其他
TOKEN_LABEL=Meme
DEFAULT_IMAGE_PATH=./default.png
LOG_FILE=./fourmeme-bot.log
PROCESSED_DB=./processed-tweets.json
